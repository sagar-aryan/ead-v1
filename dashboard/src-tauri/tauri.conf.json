{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EAD Dashboard",
  "version": "0.1.0",
  "identifier": "com.ead.dashboard",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "EAD V1 Dashboard", "width": 1280, "height": 800 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"]
  }
}
